{
  "name": "pay-it-upstream",
  "version": "0.1.0",
  "description": "Point it at your code repo. AI finds which packages keep it alive. PayPal pays them.",
  "license": "MIT",
  "homepage": "https://pay-it-upstream.ienv.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apple171/pay-it-upstream.git"
  },
  "keywords": [
    "open-source",
    "funding",
    "paypal",
    "payouts",
    "dependencies",
    "ai-agent",
    "mcp",
    "npm",
    "pypi"
  ],
  "type": "module",
  "bin": {
    "pay-it-upstream": "dist/cli.js"
  },
  "files": [
    "dist",
    "methodology",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
