# Webhook id from developer.paypal.com → your app → Webhooks (needed to verify signatures)
PAYPAL_WEBHOOK_ID=
# Shared secret the CLI sends when publishing a run (set the same LEDGER_PUBLISH_TOKEN for the CLI)
LEDGER_PUBLISH_TOKEN=
# Where the ledger JSON is stored (default ./data)
DATA_DIR=
# Dashboard AI (Anthropic Claude). The key stays on the server; leave empty to hide the assistant.
ANTHROPIC_API_KEY=
# The one model the assistant may use (default claude-opus-5-5)
CLAUDE_MODEL=
# Output token cap per AI turn (default 2048)
CLAUDE_MAX_TOKENS=
# AI_MOCK=1 gives canned AI replies with no API calls (for testing)
AI_MOCK=
# AG Studio licence key (optional; without one Studio shows a watermark off localhost)
AG_STUDIO_LICENSE=
