# PayPal REST app credentials (developer.paypal.com → Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox only: test accounts that stand in for real maintainers (comma-separated).
# Maintainers beyond this list get an address with no PayPal account, so their
# payout shows as "waiting to claim".
SANDBOX_STAND_INS=

# AI provider: "claude", "gemini", "command" (any CLI that reads a prompt on stdin
# and prints a reply) or "manual" (writes prompts to files and waits for reply files).
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high: how hard the model thinks (more effort = more tokens).
CLAUDE_EFFORT=medium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is busy.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Replies are saved in .pay-it-upstream/ai-cache so identical re-runs cost nothing.
# Set AI_CACHE=off to always call the model.
AI_COMMAND=

# Public ledger (the web app in web/). Paid runs are published with masked maintainer contacts.
LEDGER_URL=
LEDGER_PUBLISH_TOKEN=
LEDGER_COMPANY=

# Human approval. Set by `pay-it-upstream approver set`: with a site connected (LEDGER_URL +
# LEDGER_PUBLISH_TOKEN), every plan waits on <site>/approve/<run> until a person approves it
# with the approver passphrase. Only a salted hash is stored here; never the passphrase.
APPROVER_SALT=
APPROVER_HASH=
